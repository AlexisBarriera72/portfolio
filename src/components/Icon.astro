---
/**
 * Small line icons, drawn inline so they cost no request and take the text
 * colour. Decorative by default — the button or link around them carries the
 * accessible name.
 */
import type { IconId } from '../data/types';

export type UiIcon =
  | IconId
  | 'check'
  | 'arrow-up'
  | 'arrow-down'
  | 'external'
  | 'close'
  | 'play'
  | 'pause'
  | 'sound-on'
  | 'sound-off'
  | 'chat'
  | 'mail'
  | 'device'
  | 'compare'
  | 'expand';

interface Props {
  name: UiIcon;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

/** Filled glyphs; everything else is a 2px stroke. */
const FILLED = new Set<UiIcon>(['play', 'pause']);

const PATHS: Record<UiIcon, string> = {
  globe:
    'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3C9.5 5.6 8.2 8.6 8.2 12s1.3 6.4 3.8 9',
  server: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01',
  refresh: 'M20 12a8 8 0 1 1-2.34-5.66M20 4v5h-5',
  shield: 'M12 3l8 3v6c0 4.9-3.4 8-8 9-4.6-1-8-4.1-8-9V6z',
  phone:
    'M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4',
  check: 'M4 12.5l5 5L20 6.5',
  'arrow-up': 'M12 19V5M5 12l7-7 7 7',
  'arrow-down': 'M12 5v14M19 12l-7 7-7-7',
  external: 'M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5',
  close: 'M6 6l12 12M18 6L6 18',
  play: 'M8 5v14l11-7z',
  pause: 'M7 5h4v14H7zM13 5h4v14h-4z',
  'sound-on': 'M4 9h4l5-4v14l-5-4H4zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12',
  'sound-off': 'M4 9h4l5-4v14l-5-4H4zM17 9.5l5 5M22 9.5l-5 5',
  chat: 'M20 11.5a8 8 0 0 1-11.9 7l-4.1 1 1.1-4A8 8 0 1 1 20 11.5z',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  device: 'M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 18h2',
  compare: 'M9 7l-4 5 4 5M15 7l4 5-4 5',
  expand: 'M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7',
};

const filled = FILLED.has(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={PATHS[name]}></path></svg>
