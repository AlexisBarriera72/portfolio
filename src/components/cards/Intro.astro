---
import type { IntroCard, Locale } from '../../data/types';
import { t } from '../../i18n';
import Clip from '../Clip.astro';
import ClipTranscript from '../ClipTranscript.astro';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import ThemeToggle from '../ThemeToggle.astro';

interface Props {
  card: IntroCard;
  locale: Locale;
  eager: boolean;
}

const { card, locale, eager } = Astro.props;
const ui = t(locale);
---

<div class="intro">
  {/* The picture fills the card; a clip, when the card has one, plays over it. */}
  {
    card.clip ? (
      <Clip clip={card.clip} locale={locale} eager={eager} standIn={card.picture} class="intro-clip" />
    ) : (
      <div class="clip intro-clip intro-picture">
        <Img image={card.picture} locale={locale} eager={eager} class="clip-poster" />
      </div>
    )
  }
  <ThemeToggle locale={locale} />
  <div class="intro-copy">
    <p class="intro-name">{card.name}</p>
    <h2 id={`h-${card.slug}`} class="intro-heading">{card.heading[locale]}</h2>
    <p class="intro-role">{card.role[locale]}</p>
    <Cta cta={card.cta} locale={locale} class="self-start" />
    {card.clip && <ClipTranscript clip={card.clip} locale={locale} class="transcript-on-dark" />}
    <p class="swipe-hint" aria-hidden="true"><Icon name="arrow-up" size={18} />{ui.nav.swipeHint}</p>
  </div>
</div>
