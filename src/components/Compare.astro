---
/**
 * Before/after in one box: the "after" shot underneath, the "before" shot on
 * top clipped at --pos, and a handle between them. Both shots are cropped from
 * the top the same way, so the comparison lines up.
 *
 * Controls:
 *  - drag anywhere on the box (src/scripts/compare.ts). `touch-action: pan-y`
 *    leaves vertical swipes to the feed, so the box never traps scrolling;
 *  - a real range input for keyboard and screen readers — visually hidden, its
 *    focus ring drawn on the box;
 *  - a button in the corner that opens the same comparison large, in a
 *    dialog, with both shots shown whole (src/scripts/dialogs.ts). It sits
 *    beside the box, not in it, so pressing it never moves the slider.
 * Without JavaScript it is a still 50/50 split with both halves visible.
 *
 * With no "before" (the business had no site), the same box shows the new site
 * alone, and the note says what they had instead.
 *
 * The note follows the figure rather than sitting in it as a caption: the
 * figure is what shrinks to fit the card, and a caption inside it would be
 * squeezed out over the words below.
 */
import type { Locale, ProjectCard } from '../data/types';
import { t } from '../i18n';
import CompareFrame from './CompareFrame.astro';
import Icon from './Icon.astro';

interface Props {
  card: ProjectCard;
  locale: Locale;
  eager: boolean;
}

const { card, locale, eager } = Astro.props;
const ui = t(locale).project;
const { before, note } = card.beforeAfter;
const noteId = note ? `note-${card.slug}` : undefined;
const zoomId = `zoom-${card.slug}`;
---

<figure class="compare" data-compare={before ? '' : undefined}>
  <CompareFrame card={card} locale={locale} eager={eager} noteId={noteId} />
  <button
    type="button"
    class="compare-enlarge"
    data-dialog-open={zoomId}
    aria-haspopup="dialog"
    aria-controls={zoomId}
    aria-label={ui.enlargeLabel(card.client.name)}
  >
    <Icon name="expand" size={18} />
  </button>
</figure>
<dialog id={zoomId} class="demo compare-zoom" aria-labelledby={`${zoomId}-title`}>
  <div class="demo-bar">
    <h3 id={`${zoomId}-title`} class="demo-title">{ui.enlargedTitle(card.client.name, Boolean(before))}</h3>
    <form method="dialog">
      <button type="submit" class="demo-close" aria-label={ui.closeDemo}><Icon name="close" /></button>
    </form>
  </div>
  <div class="compare-zoom-stage">
    <figure class="compare" data-compare={before ? '' : undefined}>
      {/* Lazy, inside a closed dialog: the large shots load only when opened. */}
      <CompareFrame card={card} locale={locale} eager={false} noteId={noteId} />
    </figure>
  </div>
  {note && <p class="demo-lead compare-zoom-note">{note[locale]}</p>}
</dialog>
{
  note && (
    <p id={noteId} class="compare-note">
      {note[locale]}
    </p>
  )
}
